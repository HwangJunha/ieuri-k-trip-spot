{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(dart fix:*)",
      "Bash(dart run build_runner:*)",
      "Bash(flutter test:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter pub add:*)",
      "Bash(flutter gen-l10n:*)",
      "mcp__stitch__*",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Read(./**)",
      "Edit(lib/**)",
      "Edit(test/**)",
      "Edit(problem/**)",
      "Edit(pubspec.yaml)",
      "Edit(build.yaml)",
      "Edit(analysis_options.yaml)",
      "Write(lib/**)",
      "Write(test/**)",
      "Write(problem/**)",
      "Bash(flutter pub publish:*)",
      "Bash(flutter build:*)",
      "Bash(flutter run:*)",
      "Bash(flutter clean:*)",
      "Bash(flutter pub upgrade:*)",
      "Bash(flutter devices:*)",
      "Bash(flutter test integration_test:*)",
      "Bash(patrol test:*)",
      "Bash(patrol develop:*)",
      "Bash(dart run build_runner clean:*)",
      "Bash(pgrep:*)",
      "Bash(pkill -f build_runner:*)"
    ],
    "ask": [
      "Bash(dart pub upgrade:*)"
    ],
    "deny": [
      "Read(./**/*.graphql.dart)",
      "Read(./**/*.g.dart)",
      "Read(./**/*.freezed.dart)",
      "Read(./schema/schema.introspection.json)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/key.properties)",
      "Read(./**/google-services.json)",
      "Read(./**/GoogleService-Info.plist)",
      "Read(./**/*.mobileprovision)",
      "Edit(./**/*.keystore)",
      "Edit(./**/key.properties)",
      "Edit(./**/google-services.json)",
      "Edit(./**/GoogleService-Info.plist)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(dart pub publish:*)"
    ]
  },
  "env": {
    "IEURI_VAULT": "/Users/junha/Documents/Obsidian Vault"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-sensitive-paths.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-insecure-storage.sh\""
          }
        ]
      }
    ]
  }
}