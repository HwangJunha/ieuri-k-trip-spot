<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SPEC-0001 R1/R7: foreground location + notifications. No
         ACCESS_BACKGROUND_LOCATION, CAMERA, or RECORD_AUDIO. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- SPEC-0030 R25/R31: 사진에 담긴 좌표로 방문 지역을 채운다. SPEC-0001의
         "media reads 없음"을 뒤집는 결정이며 그 근거는 스펙 §5에 있다.

         ACCESS_MEDIA_LOCATION이 **함께 있어야** EXIF의 GPS가 지워지지 않는다 —
         Android 10+ 는 FUSE 계층에서 위치를 redact하며, READ_MEDIA_IMAGES만으로는
         좌표가 전부 null로 온다. Photo Picker는 권한과 무관하게 GPS를 제거하므로
         이 경로를 대체할 수 없다(설계 §4).

         READ_MEDIA_IMAGES 광범위 접근은 Play 선언 심사 대상이다(스펙 §11 리스크). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION"/>
    <!-- **부분 허용("사진 선택")을 앱이 알아보려면 이 선언이 있어야 한다**
         (사용자 지적 2026-08-26). 이것이 없으면 시스템이 앱을 **호환 모드**로
         돌려, 사용자가 몇 장만 고른 상태를 앱이 구분하지 못한다 — 안드로이드에서만
         "일부만 허용" 안내가 뜨지 않고 아이폰처럼 사진 재선택 버튼이 나오지 않은
         원인이 이것이다.

         Android 공식 문서가 targetSdk 34+ 앱에 이 선언을 요구한다:
         developer.android.com/about/versions/14/changes/partial-photo-video-access

         `photo_manager`도 매니페스트 선언과 사용자 승인을 **함께** 본다
         (`PermissionDelegate.havePermission`) — 선언이 없으면 부분 허용이
         `Limited`로 잡히지 않는다.

         READ_MEDIA_VIDEO는 넣지 않는다. 훑는 것은 사진뿐이고, 함께 요청하면
         동영상 거부가 이미지 허용과 합쳐져 전체 허용이 `Limited`로 오판된다
         (그 문제는 요청 타입을 image로 좁혀 따로 고쳤다). -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <!-- Android 12 이하는 READ_MEDIA_IMAGES가 없다. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- SPEC-0014: 지도 SDK가 타일을 내려받는 데 필요하다. 디버그 빌드는 Flutter가
         자동 주입해 지금까지 없어도 돌았지만, 릴리스 매니페스트에는 들어가지 않아
         지도가 빈 화면으로 뜬다. 위치 권한 2종은 위에 이미 있어 다시 넣지 않는다. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 공유 지도 App Links (SPEC-0030). 서버가 주는
                 `https://www.ieuri.co.kr/tour/korea-map/<token>`을 앱이 받는다.

                 `autoVerify`가 있어야 브라우저를 거치지 않고 앱이 바로 열리며,
                 그러려면 도메인에 `/.well-known/assetlinks.json`이 있어야 한다
                 (웹 몫, problem/SPEC-0030-WEB-share-link-app-open.md).

                 **다만 이것만으로는 부족하다.** 카카오톡·인스타그램은 링크를
                 인앱 브라우저(WebView)로 여는데, App Links 가로채기는 WebView
                 안에서 일어나지 않는다. 그래서 중간 페이지의 「앱에서 열기」
                 버튼을 사용자가 눌러야 이 필터가 걸린다(§중간 페이지). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="www.ieuri.co.kr"
                      android:pathPrefix="/tour/korea-map/" />
                <data android:scheme="https"
                      android:host="ieuri.co.kr"
                      android:pathPrefix="/tour/korea-map/" />
            </intent-filter>
            <!-- 앱 자체의 스킴(SPEC-0030). 회사명(ieuri)이 아니라 **앱 이름**을
                 쓴다 — applicationId `kr.ieuri.ktripspot`의 마지막 조각과 같다.

                 경로를 웹과 똑같이 두어 GoRouter 라우트 하나가 둘 다 받는다:
                   웹   https://www.ieuri.co.kr/tour/korea-map/<token>
                   스킴 ktripspot://tour/korea-map/<token>

                 **폴백이다.** 외부 링크는 App Links가 맡고, 이것은 인앱
                 브라우저에서 App Links 버튼조차 막히는 경우를 위한 대비다.
                 `autoVerify`를 붙이지 않는다 — 커스텀 스킴은 검증 대상이 아니다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ktripspot" android:host="tour" />
            </intent-filter>
        </activity>
        <!-- Kakao login redirect (spec §7): the SDK returns to this activity via
             the kakao{NATIVE_APP_KEY} scheme after the KakaoTalk/account flow. -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:scheme="kakaof3d974f8c5a77ab1fb0673c353f9cb62" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required so url_launcher can resolve a browser for the spot detail
             homepage link on Android 11+ (package visibility). Without this,
             launchUrl silently fails to find a handler. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
    </queries>
</manifest>
