<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>K-Trip Spot uses your location to show tourist attractions near you, sort them by distance, and display real-time crowd levels for each place. Without this, the app cannot tell which attractions are nearby. Your location is used only while the app is open and is never tracked in the background.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>K-Trip Spot reads the location tags stored in your photos to automatically fill in the regions you have visited on your travel map, and lets you attach photos to community posts and your profile. Photos are read on your device and are uploaded only when you choose to attach one to a post.</string>
		<!-- 수출 규정(암호화) 자진 신고. 이 앱은 HTTPS만 쓰고 자체 암호화를
		     구현하지 않으므로 면제 대상이다. **이 키가 없으면 App Store Connect가
		     업로드할 때마다 같은 질문을 되묻는다** — 값을 박아 두면 그 단계가
		     사라진다. 자체 암호화를 넣게 되면 이 값을 다시 판단해야 한다. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>K-Trip Spot</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>K-Trip Spot</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Google Sign-In (google_sign_in v7): the iOS OAuth client id. Without
		     this (or a bundled GoogleService-Info.plist / a clientId passed to
		     initialize) the SDK has no client id and the sign-in throws. This is
		     the iOS CLIENT_ID from GoogleService-Info.plist. -->
		<key>GIDClientID</key>
		<string>504325192446-vvqljuqs07v73fq5093ekl1ijt6q1cm7.apps.googleusercontent.com</string>
		<!-- SNS login (spec §7): custom URL schemes the providers redirect back to.
		     Google uses its REVERSED_CLIENT_ID; Kakao uses kakao{NATIVE_APP_KEY}. -->
		<key>CFBundleURLTypes</key>
		<array>
			<!-- 앱 자체의 스킴(SPEC-0030). 회사명(ieuri)이 아니라 **앱 이름**을 쓴다 —
			     번들 id `kr.ieuri.ktripspot`의 마지막 조각과 같다.

			     경로는 웹 URL과 **똑같이** 둔다:
			       웹   https://www.ieuri.co.kr/tour/korea-map/<token>
			       스킴 ktripspot://tour/korea-map/<token>
			     그래야 GoRouter 라우트 하나가 둘 다 받는다.

			     **주 경로가 아니라 폴백이다.** 외부에서 들어오는 링크는
			     Universal Links가 맡는다(2026 권장). 이 스킴은 카카오톡 인앱
			     브라우저에서 Universal Link 버튼조차 막히는 경우를 위한 대비이며,
			     메신저는 커스텀 스킴을 링크로 인식조차 하지 않으므로 이것만으로
			     공유를 대신할 수는 없다. -->
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>kr.ieuri.ktripspot</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>ktripspot</string>
				</array>
			</dict>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.504325192446-vvqljuqs07v73fq5093ekl1ijt6q1cm7</string>
				</array>
			</dict>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>kakaof3d974f8c5a77ab1fb0673c353f9cb62</string>
				</array>
			</dict>
		</array>
		<!-- Kakao: query schemes so the SDK can open the KakaoTalk app for login. -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>kakaokompassauth</string>
			<string>kakaolink</string>
		</array>
		<!-- FCM 푸시(SPEC-0028). 앱이 백그라운드일 때 도착한 알림을 시스템이 전달할 수
		     있게 한다. 없으면 백그라운드 수신이 조용히 누락된다. -->
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
	</dict>
</plist>
