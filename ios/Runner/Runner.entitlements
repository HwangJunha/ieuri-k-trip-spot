<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 공유 지도 링크(SPEC-0030 R37). 서버가 주는
	     `https://www.ieuri.co.kr/tour/korea-map/<token>`을 앱이 받는다.
	     커스텀 스킴(`ktripspot://`)을 공유에 쓰지 않는 이유는 카카오톡 같은 메신저가 그것을
	     링크로 인식조차 하지 않기 때문이다 — 앱이 깔려 있어도 누를 수 없다.

	     **도메인에 `apple-app-site-association`이 올라가야 실제로 열린다**(웹 몫,
	     problem/SPEC-0030-WEB-share-link-app-open.md). 그 전까지는 시뮬레이터에서
	     `xcrun simctl openurl`로만 확인할 수 있다. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.ieuri.co.kr</string>
		<string>applinks:ieuri.co.kr</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- FCM 푸시(SPEC-0028 §11). APNs 환경을 지정해야 기기가 푸시 토큰을 받는다.
	     `development`는 디버그 빌드용이며, App Store·TestFlight 배포 시 Xcode가
	     자동으로 `production`으로 바꿔 서명한다. APNs .p8 키는 Firebase 콘솔에
	     올리는 것이고 이 저장소에 넣지 않는다. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
