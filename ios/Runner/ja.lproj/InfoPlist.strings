/* 権限の使用目的（日本語）。Info.plist の英語原文をこのファイルが上書きする。 */

/* SPEC-0001 R8 — アプリ使用中のみの位置情報。 */
"NSLocationWhenInUseUsageDescription" = "K-Trip Spotは、アプリの使用中のみ位置情報を利用して、近くの観光スポットとリアルタイムの混雑状況を表示します。バックグラウンドで位置情報を追跡することはありません。";

/* SPEC-0030 R25 — 写真の位置情報から訪問地域を記録し、投稿・プロフィールに添付する。 */
"NSPhotoLibraryUsageDescription" = "写真に記録された位置情報をもとに、訪れた地域を旅行マップに自動で反映します。コミュニティ投稿やプロフィール写真の添付にも使用します。写真は端末内でのみ読み取られ、添付を選択した写真だけがアップロードされます。";

/* アプリ表示名。 */
"CFBundleDisplayName" = "K-Trip Spot";
