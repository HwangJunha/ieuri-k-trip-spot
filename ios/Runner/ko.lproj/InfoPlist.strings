/* 권한 사유 문구(한국어). Info.plist의 영어 원문을 이 파일이 덮어쓴다 —
   기기 언어가 한국어면 OS 권한 팝업에 이 문장이 뜬다.

   **Info.plist에 있는 키는 여기에도 전부 있어야 한다.** 빠뜨리면 그 항목만
   영어로 떠서 한 팝업은 한국어, 다른 팝업은 영어가 되는 상태가 된다. */

/* SPEC-0001 R8 — 앱 사용 중 위치. */
"NSLocationWhenInUseUsageDescription" = "K-Trip Spot은 앱 사용 중에만 위치를 사용해 주변 명소와 실시간 혼잡도를 보여드립니다. 백그라운드에서는 위치에 접근하지 않습니다.";

/* SPEC-0030 R25 — 사진의 위치 정보로 방문 지역을 채우고, 글·프로필에 첨부한다. */
"NSPhotoLibraryUsageDescription" = "사진에 담긴 위치 정보로 다녀온 지역을 여행 지도에 자동으로 채웁니다. 커뮤니티 글과 프로필 사진 첨부에도 사용합니다. 사진은 기기 안에서만 읽으며, 직접 첨부를 선택한 사진만 업로드됩니다.";

/* 앱 표시 이름 — 홈 화면에 뜨는 이름이다. */
"CFBundleDisplayName" = "K-Trip Spot";
